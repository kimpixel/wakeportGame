msgstr "NO LEADERBOARD"

msgid "DU"
msgstr "YOU"

msgid "RANGLISTE"
msgstr "LEADERBOARD"

msgid "Noch frei – Platz 1 wartet"
msgstr "Still free – rank 1 is waiting"

msgid "Neuer Rekord!"
msgstr "New record!"

msgid "%s überholt!"
msgstr "%s overtaken!"

msgid "%d überholt!"
msgstr "%d overtaken!"

msgid "DU · REKORD"
msgstr "YOU · RECORD"

msgid "dein Rekord"
msgstr "your record"

msgid "noch %s bis %d."
msgstr "%s to go to rank %d."

msgid "dein Name"
msgstr "your name"

msgid "Dein Name für die Rangliste (2 bis 16 Zeichen)"
msgstr "Your name for the leaderboard (2 to 16 characters)"

msgid "Wird gespeichert …"
msgstr "Saving …"

msgid "PAUSE"
msgstr "PAUSE"

msgid "Weiter  (Esc)"
msgstr "Continue  (Esc)"

msgid "Einstellungen"
msgstr "Settings"

msgid "Hilfe ein/aus"
msgstr "Help on/off"

msgid "Nächster Titel"
msgstr "Next track"

msgid "Startseite"
msgstr "Home screen"

msgid "Zurück"
msgstr "Back"

msgid "SETUP-EDITOR"
msgstr "SETUP EDITOR"

msgid "Name des Setups"
msgstr "Setup name"

msgid "Terminal 2 (Strand)"
msgstr "Terminal 2 (beach)"

msgid "Terminal 1 (Lounge-Steg)"
msgstr "Terminal 1 (lounge dock)"

msgid "Rückgängig"
msgstr "Undo"

msgid "Strg+Z"
msgstr "Ctrl+Z"

msgid "Wiederholen"
msgstr "Redo"

msgid "Strg+Y"
msgstr "Ctrl+Y"

msgid "SPEICHERN"
msgstr "SAVE"

msgid "SPEICHERN & FAHREN"
msgstr "SAVE & RIDE"

msgid "Ganze Bahn zeigen"
msgstr "Show the whole lane"

msgid "Hacks werden beim Öffnen gesammelt …"
msgstr "Hacks are collected when opening …"

msgid "Antippen stellt das Teil in die Mitte der Karte. Danach ziehen, drehen, Richtung wählen."
msgstr "Tap to place the part in the middle of the map. Then drag, rotate, choose direction."

msgid "VORLAGE LADEN   (ersetzt beide Terminals)"
msgstr "LOAD TEMPLATE   (replaces both terminals)"

msgid "TERMINAL"
msgstr "TERMINAL"

msgid "Terminal leeren"
msgstr "Clear terminal"

msgid "Vom anderen Terminal"
msgstr "From the other terminal"

msgid "Teile des anderen Terminals hierher kopieren (ersetzt dieses Terminal)"
msgstr "Copy the parts of the other terminal here (replaces this terminal)"

msgid "JSON   (zum Weitergeben oder für setups/ im Projekt)"
msgstr "JSON   (to share or for setups/ in the project)"

msgid "Hier ein Setup-JSON einfügen und „Aus Text laden“ drücken"
msgstr "Paste a setup JSON here and press “Load from text”"

msgid "Als JSON kopieren"
msgstr "Copy as JSON"

msgid "JSON in die Zwischenablage kopiert"
msgstr "JSON copied to the clipboard"

msgid "Aus Text laden"
msgstr "Load from text"

msgid "Eigenes Setup löschen"
msgstr "Delete custom setup"

msgid "Leeres Setup"
msgstr "Empty setup"

msgid "Nicht gespeichert! Nochmal „Zurück“ = trotzdem verlassen (bleibt bis zum Neuladen erhalten)"
msgstr "Not saved! Press “Back” again = leave anyway (kept until reload)"

msgid "Mein %s"
msgstr "My %s"

msgid "verschieben   s %+.1f m   x %+.1f m"
msgstr "move   s %+.1f m   x %+.1f m"

msgid "%s eingefügt"
msgstr "%s inserted"

msgid ""
"Nichts ausgewählt. Ein Feature in der Karte antippen (doppelt = ganzer Hack), Umschalt/Strg + Klick wählt mehrere.\n"
"\n"
"Tasten: Pfeile verschieben (Umschalt 1 m), Q/E drehen, F Richtung, M spiegeln, Strg+D duplizieren, Entf löschen, Strg+Z rückgängig."
msgstr ""
"Nothing selected. Tap a feature on the map (double = whole hack), Shift/Ctrl + click selects several.\n"
"\n"
"Keys: arrows move (Shift 1 m), Q/E rotate, F direction, M mirror, Ctrl+D duplicate, Del delete, Ctrl+Z undo."

msgid "POSITION ENTLANG DES SEILS  s (m)"
msgstr "POSITION ALONG THE ROPE  s (m)"

msgid "SEITLICH  x (m)   + rechts, − links (Blick zum Endmast)"
msgstr "SIDEWAYS  x (m)   + right, − left (looking towards the end tower)"

msgid "DREHUNG (Grad)"
msgstr "ROTATION (degrees)"

msgid "RICHTUNG (Anfahrt)"
msgstr "DIRECTION (approach)"

msgid "%d Teile ausgewählt – sie werden gemeinsam verschoben, gedreht und gespiegelt."
msgstr "%d parts selected – they are moved, rotated and mirrored together."

msgid "%d Teil"
msgid_plural "%d Teile"
msgstr[0] "%d part"
