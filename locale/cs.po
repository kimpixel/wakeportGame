msgstr "dubna"

msgid "Mai"
msgstr "května"

msgid "Juni"
msgstr "června"

msgid "Juli"
msgstr "července"

msgid "August"
msgstr "srpna"

msgid "September"
msgstr "září"

msgid "Oktober"
msgstr "října"

msgid "November"
msgstr "listopadu"

msgid "Dezember"
msgstr "prosince"

msgid "%d %% eingesunken"
msgstr "%d %% ponoření"

msgid "%d %% im Press"
msgstr "%d %% v pressu"

msgid "%d Wechsel"
msgid_plural "%d Wechsel"
msgstr[0] "%d změna"
msgstr[1] "%d změny"
msgstr[2] "%d změn"

msgid "%d Slider"
