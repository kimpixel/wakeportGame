#: setups/parts.json
msgid "Kicker M"
msgstr ""

#: scripts/training.gd:91
msgid "Kicker M überfahren"
msgstr ""

#: scripts/training.gd:95
msgid "Fahr ohne Absprung gerade über den Kicker M (der kleinere, näher am Seil). Gemessen wird die größte Höhe über dem Wasser."
msgstr ""

#: scripts/training.gd:96
msgid "← / →  lenken     Leertaste halten + loslassen  Absprung"
msgstr ""

#: scripts/training.gd:97
msgid "Neigen  lenken     SPRUNG halten + loslassen  Absprung"
msgstr ""

#: scripts/training.gd:98
msgid "Gerade und mit Tempo anfahren – schräg verliert man Höhe. Kurz vor dem Kicker nicht mehr lenken."
msgstr ""

#: scripts/training.gd:99
msgid "M mit Absprung"
msgstr ""

#: scripts/training.gd:99
msgid "Kicker M mit Absprung"
msgstr ""

#: scripts/training.gd:103
msgid "Wie eben, aber an der Kante abspringen: Kicker-Steigung + Sprungkraft = Höhe."
msgstr ""

#: scripts/training.gd:104
msgid "Leertaste halten (auf dem Kicker) + an der Kante loslassen"
msgstr ""

#: scripts/training.gd:105
msgid "SPRUNG halten (auf dem Kicker) + an der Kante loslassen"
msgstr ""

#: scripts/training.gd:106
msgid "Schon auf dem Kicker voll aufladen und genau an der Kante loslassen – zu früh verschenkt den Wurf der Rampe."
msgstr ""

#: scripts/training.gd:107
#: setups/parts.json
msgid "Kicker L"
msgstr ""

#: scripts/training.gd:107
msgid "Kicker L mit Absprung"
msgstr ""

#: scripts/training.gd:111
msgid "Der große Kicker L (rechts): höher, steiler – und härter bei der Landung."
msgstr ""

#: scripts/training.gd:112
#: scripts/training.gd:376
msgid "Leertaste halten + an der Kante loslassen"
msgstr ""

#: scripts/training.gd:113
#: scripts/training.gd:377
msgid "SPRUNG halten + an der Kante loslassen"
msgstr ""

#: scripts/training.gd:114
msgid "Bei der Landung gerade bleiben – wer quer aufkommt, stürzt."
msgstr ""

#: scripts/training.gd:116
msgid "Slider"
msgstr ""

#: scripts/training.gd:116
msgid "Slider fahren: aufspringen, 50-50, Boardslide, Press."
msgstr ""

#: scripts/training.gd:117
#: scripts/training.gd:177
#: scripts/training.gd:187
msgid "Full Pipe"
msgstr ""

#: scripts/training.gd:117
msgid "Rauf auf die Full Pipe"
msgstr ""

#: scripts/training.gd:121
msgid "Fahr über die Auffahrt auf die Full Pipe und rutsch sie so weit wie möglich ab. Gemessen: gerutschte Meter."
msgstr ""

#: scripts/training.gd:122
msgid "← / →  lenken (auf dem Slider: Boardslide / 50-50)"
msgstr ""

#: scripts/training.gd:123
msgid "Neigen  lenken (auf dem Slider deutlich neigen: Boardslide / 50-50)"
msgstr ""

#: scripts/training.gd:124
msgid "Mittig auf die Auffahrt zielen. Auf dem Rohr hält dich das Einloggen in der Spur."
msgstr ""

#: scripts/training.gd:125
msgid "Boardslide"
msgstr ""

#: scripts/training.gd:125
msgid "Boardslide auf der Pipe"
msgstr ""

#: scripts/training.gd:129
msgid "Quer über die Pipe: nur Meter im Boardslide zählen. Am Ende das Brett wieder gerade stellen – wer quer ins Wasser fährt, stürzt."
msgstr ""

#: scripts/training.gd:130
msgid "Auf der Pipe ← / → tippen (Boardslide), vor dem Ende nochmal tippen (zurück auf 50-50)"
msgstr ""

#: scripts/training.gd:131
msgid "Auf der Pipe deutlich neigen (Boardslide), vor dem Ende nochmal neigen (zurück auf 50-50)"
msgstr ""

#: scripts/training.gd:132
msgid "Oder schon in der Luft quer drehen – das Brett rastet in die nächste Stellung ein. Kurz vor dem Ende umspringen oder auf der Abfahrt gerade drehen."
msgstr ""

#: scripts/training.gd:133
msgid "Drift"
msgstr ""

#: scripts/training.gd:133
msgid "Boardslide mit Drift-Abgang"
msgstr ""

#: scripts/training.gd:137
msgid "Boardslide über die Pipe und quer bleiben – beim Abgang Drift halten: dann rutscht das Brett quer weiter, ohne einzuhaken."
msgstr ""

#: scripts/training.gd:138
msgid "Auf der Pipe ← / → tippen (Boardslide), Strg (Drift) halten, wenn das Brett das Wasser berührt"
msgstr ""

#: scripts/training.gd:139
msgid "Auf der Pipe deutlich neigen (Boardslide), DRIFT halten, wenn das Brett das Wasser berührt"
msgstr ""

#: scripts/training.gd:140
msgid "Drift rechtzeitig drücken – kurz vor dem Ende der Pipe. Wer das Brett gerade stellt, bekommt hier keinen Wert."
msgstr ""

#: scripts/training.gd:141
msgid "Umspringen"
msgstr ""

#: scripts/training.gd:141
msgid "Boardslide / 50-50 umspringen"
msgstr ""

#: scripts/training.gd:145
msgid "Auf dem Long Rail (links, 100 m) zwischen Boardslide und 50-50 wechseln. Gezählt werden die Wechsel."
msgstr ""

#: scripts/training.gd:146
msgid "Auf dem Slider: je Tipp ← / →  90° drehen"
msgstr ""

#: scripts/training.gd:147
msgid "Auf dem Slider: deutlich neigen, zurück, wieder neigen"
msgstr ""

#: scripts/training.gd:148
msgid "Nach jedem Tipp loslassen – erst dann geht der nächste Wechsel."
msgstr ""

#: scripts/training.gd:149
msgid "Press"
msgstr ""

#: scripts/training.gd:149
msgid "Nose- oder Tailpress"
msgstr ""

#: scripts/training.gd:153
msgid "Auf dem Long Rail Gewicht auf Nose oder Tail: gemessen werden die Sekunden im Press."
msgstr ""

#: scripts/training.gd:154
msgid "Auf dem Slider: ↑  Nosepress    ↓  Tailpress (halten)"
msgstr ""

#: scripts/training.gd:155
msgid "Auf dem Slider: ▲  Nosepress    ▼  Tailpress (halten)"
msgstr ""

#: scripts/training.gd:156
msgid "Erst sauber auf dem Rail stehen, dann ↑ oder ↓ halten. Beim Absprung loslassen, sonst gibt es keinen Überschlag."
msgstr ""

#: scripts/training.gd:157
msgid "Long Rail"
msgstr ""

#: scripts/training.gd:157
msgid "Long Rail: 100 m"
msgstr ""

#: scripts/training.gd:161
msgid "So weit wie möglich auf dem 100-m-Rail bleiben."
msgstr ""

#: scripts/training.gd:162
msgid "← / →  lenken"
msgstr ""

#: scripts/training.gd:163
msgid "Neigen  lenken"
msgstr ""

#: scripts/training.gd:164
msgid "Der Seilzug zieht dich zur Seilmitte – auf dem Rail nicht gegenlenken, das Einloggen hält die Spur."
msgstr ""

#: scripts/training.gd:165
msgid "Slider-Kette"
msgstr ""

#: scripts/training.gd:169
msgid "Rechts stehen vier Slider hintereinander: Full Pipe, Rail, A-Frame, Pipe. Wie viele schaffst du in einer Fahrt?"
msgstr ""

#: scripts/training.gd:170
#: scripts/training.gd:408
#: scripts/training.gd:432
#: scripts/training.gd:440
msgid "← / →  lenken     Leertaste  Absprung"
msgstr ""

#: scripts/training.gd:171
#: scripts/training.gd:409
#: scripts/training.gd:433
#: scripts/training.gd:441
msgid "Neigen  lenken     SPRUNG  Absprung"
msgstr ""

#: scripts/training.gd:172
msgid "Nach jedem Slider zieht dich das Seil nach innen: sofort wieder nach außen auf Linie lenken – alle stehen auf derselben Spur."
msgstr ""

#: scripts/training.gd:173
msgid "BS Nosepress"
msgstr ""

#: scripts/training.gd:173
msgid "Ollie in Boardslide Nosepress"
msgstr ""

#: scripts/training.gd:178
msgid "Mit einem Ollie aus dem Wasser direkt auf die Full Pipe, in der Luft quer drehen und im Boardslide mit Nosepress rutschen. Gemessen: gerutschte Meter – nur wenn Ollie on, Boardslide und Nosepress stimmen."
msgstr ""

#: scripts/training.gd:179
msgid "Leertaste  Ollie     in der Luft ← / → kurz tippen (Vierteldrehung)     auf der Pipe ↑ halten"
msgstr ""

#: scripts/training.gd:180
msgid "SPRUNG  Ollie     in der Luft kurz neigen (Vierteldrehung)     auf der Pipe ▲ halten"
msgstr ""

#: scripts/training.gd:181
msgid "Nicht über die Auffahrt fahren, sondern vor der Pipe abspringen. Eine Vierteldrehung reicht – das Brett rastet quer ein. Am Ende das Brett gerade stellen (← / →) oder Drift halten, sonst stürzt man quer ins Wasser."
msgstr ""

