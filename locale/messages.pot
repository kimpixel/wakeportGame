#: scripts/training.gd:339
msgid "Special"
msgstr ""

#: scripts/training.gd:182
msgid "Slider Special"
msgstr ""

#: scripts/training.gd:188
msgid "Rail"
msgstr ""

#: scripts/training.gd:189
msgid "A-Frame"
msgstr ""

#: scripts/training.gd:190
msgid "Pipe"
msgstr ""

#: scripts/training.gd:192
msgid "Die Slider-Kette rechts, an jedem Slider eine feste Kombination. Gezählt: geschaffte Slider."
msgstr ""

#: scripts/training.gd:193
msgid "Leertaste  Ollie on / out     ← / →  in der Luft drehen, auf dem Slider Boardslide / 50-50     ↑ / ↓  Nose- / Tailpress"
msgstr ""

#: scripts/training.gd:194
msgid "SPRUNG  Ollie on / out     Neigen  in der Luft drehen, auf dem Slider Boardslide / 50-50     ▲ / ▼  Nose- / Tailpress"
msgstr ""

#: scripts/training.gd:195
msgid "Ollie on heißt: aus dem Wasser direkt auf das Rohr springen, nicht über die Auffahrt fahren. Den Press mehr als die halbe Slide-Zeit halten."
msgstr ""

#: scripts/training.gd:199
msgid "Invert Training"
msgstr ""

#: scripts/training.gd:199
msgid "Inverts: Tricks aus dem Raley-Absprung nach der Wende."
msgstr ""

#: scripts/training.gd:200
msgid "Raley – Höhe"
msgstr ""

#: scripts/training.gd:200
msgid "Höchster Raley"
msgstr ""

#: scripts/training.gd:203
msgid "Nach der Ufer-Wende Seilzug aufbauen und einen Raley stehen – ohne Drehung, ohne Extras. Gemessen: größte Höhe."
msgstr ""

#: scripts/training.gd:204
#: scripts/training.gd:211
msgid "Leertaste lange halten (voll aufladen) + loslassen, wenn der Seilzug über der Marke RALEY ist"
msgstr ""

#: scripts/training.gd:205
#: scripts/training.gd:212
msgid "SPRUNG lange halten (voll aufladen) + loslassen, wenn der Seilzug über der Marke RALEY ist"
msgstr ""

#: scripts/training.gd:206
msgid "Nach der Wende weit nach außen fahren, dann hart gegen den Zug zur Seilmitte kanten – loslassen, solange der Seilzug über der Marke RALEY ist – je mehr Zug und Tempo, desto höher."
msgstr ""

#: scripts/training.gd:207
msgid "Raley – Weite"
msgstr ""

#: scripts/training.gd:207
msgid "Weitester Raley"
msgstr ""

#: scripts/training.gd:210
msgid "Nach der Ufer-Wende Seilzug aufbauen und einen Raley stehen – ohne Drehung, ohne Extras. Gemessen: Weite vom Absprung bis zur Landung."
msgstr ""

#: scripts/training.gd:213
msgid "Weit nach außen, dann hart zur Seilmitte kanten – je mehr Zug und Tempo, desto weiter."
msgstr ""

